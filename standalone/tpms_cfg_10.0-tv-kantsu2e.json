{
    "type": "performance",
    "plan_path": "",
    "script_path": "../performance/script",
    "target_installable_path": "../performance/target_installable",
    "enabled": {
        "build_info_test": "enable",
        "booting_time_test": "enable",
        "memory_usage_test": "enable",
        "nand_usage_test": "enable",
        "rootfs_usage_test": "enable",
        "app_launching_test": "enable",
        "web_app_launching_test": "enable",
        "dali_3d_ui_test": "enable",
        "glbench_test": "disable",
        "octane_test": "disable",
        "process_memory_usage_test": "enable",
        "memory_info_test": "enable",
        "dependency_info_test": "disable",
        "per_lib_memory_consumption_test": "disable",
        "per_lib_time_consumption_test": "disable",
        "efl_benchmark_test": "disable",
        "applaunch_memstress_test": "disable",
        "ffmpeg_benchmark_test": "enable",
        "gstreamer_benchmark_test": "enable",
        "tflite_benchmark_test": "disable",
        "kernel_benchmark_test": "enable",
        "dotnet_benchmark_test": "enable"
    },
    "memory_rigor": {
        "enabled": true,
        "boots": 3,
        "samples": 5,
        "interval_s": 30,
        "min_uptime_s": 600,
        "gate_interval_s": 30,
        "window": 10,
        "memory_range_fraction": 0.01,
        "cpu_max_percent": 21,
        "max_wait_s": 1800,
        "coverage_min": 0.95,
        "ion_shrink": false,
        "expected_nevra": "",
        "enforce_version": false,
        "capture_policy": "fixed_uptime",
        "capture_uptime_s": 1800,
        "min_valid_samples_per_boot": 3,
        "initial_gate": true
    }
}
